{
  "name": "secondlook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @secondlook/api\" \"npm run dev -w @secondlook/web\"",
    "dev:mobile": "npm run start -w @secondlook/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @secondlook/api",
    "build": "npm run build -w @secondlook/web",
    "db:migrate": "npm run db:migrate -w @secondlook/api",
    "db:seed": "npm run db:seed -w @secondlook/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
