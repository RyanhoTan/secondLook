{
  "name": "secondlook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @secondlook/api\" \"npm run dev -w @secondlook/web\"",
    "dev:mobile": "npm run start -w @secondlook/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @secondlook/api",
    "build": "npm run build -w @secondlook/web",
    "db:migrate": "npm exec -w @secondlook/api -- prisma migrate dev",
    "db:seed": "npm run db:seed -w @secondlook/api",
    "test:e2e": "npm run test:e2e -w @secondlook/web",
    "db:generate": "npm run db:generate -w @secondlook/api",
    "db:deploy": "npm run db:deploy -w @secondlook/api",
    "lint": "npm run lint -w @secondlook/mobile",
    "setup": "node scripts/setup.mjs",
    "export:mobile": "npm run export -w @secondlook/mobile"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
