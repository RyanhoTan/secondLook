generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model User {
  id String @id @default(cuid())
  username String @unique
  nickname String
  passwordHash String
  role String @default("USER")
  sessions Session[]
  posts Post[]
  follows Follow[]
  notifications Notification[]
  materials Material[]
  drafts PostDraft[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
}
model Subject {
  id String @id @default(cuid())
  name String
  category String
  city String
  address String @default("")
  createdAt DateTime @default(now())
  posts Post[]
  drafts PostDraft[]
  @@unique([name,category,city,address])
}
model Post {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields:[authorId],references:[id])
  subjectId String
  subject Subject @relation(fields:[subjectId],references:[id])
  title String
  body String
  occurredOn String
  anonymous Boolean @default(false)
  status String @default("PENDING")
  evidence String @default("STATEMENT")
  disputed Boolean @default(false)
  reason String?
  createdAt DateTime @default(now())
  publishedAt DateTime?
  currentVersion Int @default(1)
  submissionKey String?
  submissionDigest String?
  revisions PostRevision[]
  issues PostIssue[]
  updates ProgressUpdate[]
  follows Follow[]
  events TimelineEvent[]
  materials Material[]
  draft PostDraft?
  @@index([status,publishedAt])
  @@index([subjectId,status])
  @@unique([authorId,submissionKey])
}
model PostIssue {
  postId String
  post Post @relation(fields:[postId],references:[id],onDelete:Cascade)
  code String
  @@id([postId,code])
  @@index([code,postId])
}
model PostDraft {
  issueTypes Json @default("[]")
  id String @id
  authorId String
  author User @relation(fields:[authorId],references:[id])
  subjectId String?
  subject Subject? @relation(fields:[subjectId],references:[id])
  title String
  body String
  occurredOn String
  anonymous Boolean
  personalExperience Boolean
  version Int @default(1)
  mutationKey String
  postId String? @unique
  post Post? @relation(fields:[postId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([authorId,updatedAt])
}
model PostRevision {
  issueTypes Json @default("[]")
  id String @id @default(cuid())
  postId String
  post Post @relation(fields:[postId],references:[id])
  version Int?
  baseVersion Int
  pendingKey String? @unique
  title String
  body String
  occurredOn String
  changeReason String
  status String @default("PENDING")
  reviewReason String?
  visible Boolean @default(true)
  createdAt DateTime @default(now())
  publishedAt DateTime?
  events TimelineEvent[]
  @@unique([postId,version])
  @@index([postId,status])
}
model ProgressUpdate {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields:[postId],references:[id])
  title String
  body String
  status String @default("PENDING")
  reason String?
  createdAt DateTime @default(now())
}
model Material {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields:[postId],references:[id])
  uploaderId String
  uploader User @relation(fields:[uploaderId],references:[id])
  clientKey String
  source String
  visibility String
  status String @default("PENDING")
  submittedVersion Int?
  reviewVersion Int @default(1)
  versions MaterialVersion[]
  originalKey String
  previewKey String
  publicKey String?
  digest String
  mime String
  width Int
  height Int
  size Int
  reason String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@unique([uploaderId,clientKey])
  @@index([postId,status])
}
model MaterialVersion {
  id String @id @default(cuid())
  materialId String
  material Material @relation(fields:[materialId],references:[id])
  version Int
  status String @default("PENDING")
  publicKey String?
  reason String?
  reviewedAt DateTime?
  @@unique([materialId,version])
  @@index([version,status])
}
model TimelineEvent {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields:[postId],references:[id])
  title String
  body String
  kind String
  revisionId String?
  revision PostRevision? @relation(fields:[revisionId],references:[id])
  createdAt DateTime @default(now())
  notifications Notification[]
}
model Follow {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  postId String
  post Post @relation(fields:[postId],references:[id],onDelete:Cascade)
  @@unique([userId,postId])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  eventId String
  event TimelineEvent @relation(fields:[eventId],references:[id])
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([userId,eventId])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  targetId String
  action String
  reason String
  createdAt DateTime @default(now())
}
